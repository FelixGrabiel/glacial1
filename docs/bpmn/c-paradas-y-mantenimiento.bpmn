<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_paradas_mantenimiento" targetNamespace="http://glacial.pe/bpmn/paradas_mantenimiento" exporter="GLACIAL documentación" exporterVersion="1.0">
  <bpmn:dataStore id="DS_workers" name="sync/workers" />
  <bpmn:dataStore id="DS_tecnicosMant" name="sync/tecnicosMant" />
  <bpmn:dataStore id="DS_configMant" name="sync/configMantenimiento" />
  <bpmn:dataStore id="DS_rotMant" name="sync/rotacionesMantenimiento" />
  <bpmn:dataStore id="DS_programaciones" name="sync/programaciones" />
  <bpmn:dataStore id="DS_bitacora" name="bitacoraMantenimiento" />
  <bpmn:dataStore id="DS_configAlertas" name="sync/configAlertas" />
  <bpmn:collaboration id="Collaboration_paradas_mantenimiento">
    <bpmn:participant id="pT" name="Técnico de Mantenimiento" processRef="Process_pT" />
    <bpmn:participant id="pS" name="Sistema GLACIAL" processRef="Process_pS" />
    <bpmn:participant id="pM" name="Supervisión y Jefatura" processRef="Process_pM" />
    <bpmn:messageFlow id="MF_0" name="Inicio de sesión" sourceRef="T0" targetRef="sA1" />
    <bpmn:messageFlow id="MF_1" name="PIN" sourceRef="T3" targetRef="sA2" />
    <bpmn:messageFlow id="MF_2" name="PIN nuevo" sourceRef="T2" targetRef="sA2" />
    <bpmn:messageFlow id="MF_3" name="Identificación aceptada" sourceRef="S5" targetRef="T4" />
    <bpmn:messageFlow id="MF_4" name="PIN incorrecto" sourceRef="S6" targetRef="T3b" />
    <bpmn:messageFlow id="MF_5" name="Bloqueo 10 min" sourceRef="S7" targetRef="T3c" />
    <bpmn:messageFlow id="MF_6" name="Detener línea" sourceRef="T5" targetRef="sB" />
    <bpmn:messageFlow id="MF_7" name="Intervención terminada" sourceRef="T7" targetRef="sC" />
    <bpmn:messageFlow id="MF_8" name="Reanudar" sourceRef="T8" targetRef="sD" />
    <bpmn:messageFlow id="MF_9" name="Motivo" sourceRef="T9" targetRef="sI" />
    <bpmn:messageFlow id="MF_10" name="Alerta en tiempo real" sourceRef="S11" targetRef="spDet" />
    <bpmn:messageFlow id="MF_11" name="Alerta en tiempo real" sourceRef="S11" targetRef="smDet" />
    <bpmn:messageFlow id="MF_12" name="Alerta en tiempo real" sourceRef="S11" targetRef="jDet" />
    <bpmn:messageFlow id="MF_13" name="Alerta en tiempo real" sourceRef="S14" targetRef="spRea" />
    <bpmn:messageFlow id="MF_14" name="Alerta en tiempo real" sourceRef="S14" targetRef="smRea" />
    <bpmn:messageFlow id="MF_15" name="Alerta en tiempo real" sourceRef="S14" targetRef="jRea" />
    <bpmn:messageFlow id="MF_16" name="Aviso en tiempo real" sourceRef="SE2" targetRef="spPar" />
    <bpmn:messageFlow id="MF_17" name="Aviso en tiempo real" sourceRef="SE2" targetRef="smPar" />
    <bpmn:messageFlow id="MF_18" name="Aviso en tiempo real" sourceRef="SE2" targetRef="jPar" />
    <bpmn:messageFlow id="MF_19" name="Consulta" sourceRef="J1" targetRef="sG" />
    <bpmn:messageFlow id="MF_20" name="Motivo" sourceRef="SM1" targetRef="sH" />
    <bpmn:messageFlow id="MF_21" name="Cierre" sourceRef="SP1" targetRef="sJ" />
    <bpmn:messageFlow id="MF_22" name="Aviso" sourceRef="SJ2" targetRef="spPend" />
  </bpmn:collaboration>
  <bpmn:process id="Process_pT" name="Técnico de Mantenimiento" isExecutable="false">
    <bpmn:laneSet id="LaneSet_pT">
      <bpmn:lane id="lT" name="Técnico de Mantenimiento">
        <bpmn:flowNodeRef>tStart</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EBG</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T3c</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T3b</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>eT3c</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GT2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T5b</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GT3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>eT</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>tS2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>eT9</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="tStart" name="Necesita operar una línea" />
    <bpmn:userTask id="T0" name="Iniciar sesión con la cuenta compartida de Mantenimiento" />
    <bpmn:userTask id="T1" name="Elegir su nombre en «¿Quién eres?»" />
    <bpmn:exclusiveGateway id="G1" name="¿Ya tiene PIN?" />
    <bpmn:userTask id="T3" name="Ingresar su PIN" />
    <bpmn:userTask id="T2" name="Crear su PIN (4 a 6 dígitos, dos veces)" />
    <bpmn:eventBasedGateway id="EBG" name="Respuesta del sistema" />
    <bpmn:intermediateCatchEvent id="T3c" name="Bloqueado 10 min"><bpmn:messageEventDefinition id="MED_T3c" /></bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="T4" name="Identificación aceptada (chip con su nombre)"><bpmn:messageEventDefinition id="MED_T4" /></bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="T3b" name="PIN incorrecto"><bpmn:messageEventDefinition id="MED_T3b" /></bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="eT3c" name="Espera 10 min y vuelve a intentar" />
    <bpmn:exclusiveGateway id="GT2" name="¿Qué necesita hacer?" />
    <bpmn:userTask id="T5" name="Detener línea: elegir el motivo del catálogo (no programada)" />
    <bpmn:userTask id="T5b" name="Pausa programada: elegir el motivo (con estándar en min)" />
    <bpmn:manualTask id="T6" name="Realizar la intervención en la línea" />
    <bpmn:userTask id="T7" name="Marcar «Intervención terminada»" />
    <bpmn:exclusiveGateway id="GT3" name="" />
    <bpmn:userTask id="T8" name="Reanudar producción" />
    <bpmn:endEvent id="eT" name="Línea en producción" />
    <bpmn:startEvent id="tS2" name="Ve una parada con motivo pendiente" />
    <bpmn:userTask id="T9" name="Completar el motivo (≥ 5 caracteres) desde el semáforo" />
    <bpmn:endEvent id="eT9" name="Motivo completado" />
    <bpmn:sequenceFlow id="SF_0" name="" sourceRef="tStart" targetRef="T0" />
    <bpmn:sequenceFlow id="SF_1" name="" sourceRef="T0" targetRef="T1" />
    <bpmn:sequenceFlow id="SF_2" name="" sourceRef="T1" targetRef="G1" />
    <bpmn:sequenceFlow id="SF_3" name="Sí" sourceRef="G1" targetRef="T3" />
    <bpmn:sequenceFlow id="SF_4" name="No" sourceRef="G1" targetRef="T2" />
    <bpmn:sequenceFlow id="SF_5" name="" sourceRef="T3" targetRef="EBG" />
    <bpmn:sequenceFlow id="SF_6" name="" sourceRef="T2" targetRef="EBG" />
    <bpmn:sequenceFlow id="SF_7" name="" sourceRef="EBG" targetRef="T3c" />
    <bpmn:sequenceFlow id="SF_8" name="" sourceRef="EBG" targetRef="T4" />
    <bpmn:sequenceFlow id="SF_9" name="" sourceRef="EBG" targetRef="T3b" />
    <bpmn:sequenceFlow id="SF_10" name="" sourceRef="T3c" targetRef="eT3c" />
    <bpmn:sequenceFlow id="SF_11" name="" sourceRef="T3b" targetRef="T3" />
    <bpmn:sequenceFlow id="SF_12" name="" sourceRef="T4" targetRef="GT2" />
    <bpmn:sequenceFlow id="SF_13" name="Detener" sourceRef="GT2" targetRef="T5" />
    <bpmn:sequenceFlow id="SF_14" name="Pausa" sourceRef="GT2" targetRef="T5b" />
    <bpmn:sequenceFlow id="SF_15" name="" sourceRef="T5" targetRef="T6" />
    <bpmn:sequenceFlow id="SF_16" name="" sourceRef="T6" targetRef="T7" />
    <bpmn:sequenceFlow id="SF_17" name="" sourceRef="T7" targetRef="GT3" />
    <bpmn:sequenceFlow id="SF_18" name="" sourceRef="T5b" targetRef="GT3" />
    <bpmn:sequenceFlow id="SF_19" name="" sourceRef="GT3" targetRef="T8" />
    <bpmn:sequenceFlow id="SF_20" name="" sourceRef="T8" targetRef="eT" />
    <bpmn:sequenceFlow id="SF_21" name="" sourceRef="tS2" targetRef="T9" />
    <bpmn:sequenceFlow id="SF_22" name="" sourceRef="T9" targetRef="eT9" />
  </bpmn:process>
  <bpmn:process id="Process_pS" name="Sistema GLACIAL" isExecutable="false">
    <bpmn:laneSet id="LaneSet_pS">
      <bpmn:lane id="lS" name="Automático (navegador + Firestore)">
        <bpmn:flowNodeRef>sA1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>eA1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sV</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gV</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SV2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>eV</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>eV2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sA2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gS0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S2a</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S2v</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gS1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>eA2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gS2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>eS6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>tm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>eS7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sB</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gB1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>eB1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gB2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S15</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>eB2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sC</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>eC</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sD</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S14</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>eD</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sI</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S16</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>eI</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sE</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SE1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gE</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SE2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>eE</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>eE2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sG</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SG1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>eG</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sH</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SH1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>eH</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sJ</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SJ1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SJ2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>eJ</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="sA1" name="Inicio de sesión con la cuenta compartida"><bpmn:messageEventDefinition id="MED_sA1" /></bpmn:startEvent>
    <bpmn:serviceTask id="S1" name="Abrir «¿Quién eres?» y bloquear la pantalla hasta identificar"><bpmn:dataInputAssociation id="DIA_S1_dsW"><bpmn:sourceRef>dsW</bpmn:sourceRef></bpmn:dataInputAssociation></bpmn:serviceTask>
    <bpmn:endEvent id="eA1" name="Pantalla bloqueada hasta identificar" />
    <bpmn:startEvent id="sV" name="Cada 20 s"><bpmn:timerEventDefinition id="TED_sV"><bpmn:timeCycle xsi:type="bpmn:tFormalExpression">R/PT20S</bpmn:timeCycle></bpmn:timerEventDefinition></bpmn:startEvent>
    <bpmn:exclusiveGateway id="gV" name="¿Identificación vigente?" />
    <bpmn:serviceTask id="SV2" name="Cerrar la identificación y volver a pedir «¿Quién eres?»" />
    <bpmn:endEvent id="eV" name="Vuelve a identificarse" />
    <bpmn:endEvent id="eV2" name="Sigue identificado" />
    <bpmn:startEvent id="sA2" name="PIN enviado por el técnico"><bpmn:messageEventDefinition id="MED_sA2" /></bpmn:startEvent>
    <bpmn:exclusiveGateway id="gS0" name="¿PIN nuevo?" />
    <bpmn:serviceTask id="S2a" name="Validar el PIN y crearlo: sal + PBKDF2 (100 000 vueltas) → hash"><bpmn:dataOutputAssociation id="DOA_S2a_dsT"><bpmn:targetRef>dsT</bpmn:targetRef></bpmn:dataOutputAssociation></bpmn:serviceTask>
    <bpmn:serviceTask id="S2v" name="Verificar el PIN contra el hash y contar intentos"><bpmn:dataInputAssociation id="DIA_S2v_dsT"><bpmn:sourceRef>dsT</bpmn:sourceRef></bpmn:dataInputAssociation><bpmn:dataOutputAssociation id="DOA_S2v_dsT"><bpmn:targetRef>dsT</bpmn:targetRef></bpmn:dataOutputAssociation></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="gS1" name="¿PIN correcto?" />
    <bpmn:serviceTask id="S5" name="Iniciar la sesión del técnico (vence por fin de turno, inactividad o límite)"><bpmn:dataInputAssociation id="DIA_S5_dsC"><bpmn:sourceRef>dsC</bpmn:sourceRef></bpmn:dataInputAssociation><bpmn:dataInputAssociation id="DIA_S5_dsR"><bpmn:sourceRef>dsR</bpmn:sourceRef></bpmn:dataInputAssociation></bpmn:serviceTask>
    <bpmn:endEvent id="eA2" name="Técnico identificado" />
    <bpmn:exclusiveGateway id="gS2" name="¿5 intentos fallidos?" />
    <bpmn:serviceTask id="S6" name="Mostrar «PIN incorrecto» e intentos restantes" />
    <bpmn:endEvent id="eS6" name="Puede reintentar" />
    <bpmn:serviceTask id="S7" name="Bloquear al técnico 10 minutos" />
    <bpmn:intermediateCatchEvent id="tm" name="10 min"><bpmn:timerEventDefinition id="TED_tm"><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT10M</bpmn:timeDuration></bpmn:timerEventDefinition></bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="eS7" name="Puede reintentar" />
    <bpmn:startEvent id="sB" name="Detención solicitada"><bpmn:messageEventDefinition id="MED_sB" /></bpmn:startEvent>
    <bpmn:serviceTask id="S8" name="Leer el estado de la línea en una transacción"><bpmn:dataInputAssociation id="DIA_S8_dsP1"><bpmn:sourceRef>dsP1</bpmn:sourceRef></bpmn:dataInputAssociation></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="gB1" name="¿Otro usuario ya la detuvo?" />
    <bpmn:serviceTask id="S9" name="Avisar «otro usuario ya la detuvo» sin duplicar el registro" />
    <bpmn:endEvent id="eB1" name="Sin cambios" />
    <bpmn:serviceTask id="S10" name="Guardar DETENIDA, parada abierta e historial; crear el evento DETENER (misma transacción)"><bpmn:dataOutputAssociation id="DOA_S10_dsP1"><bpmn:targetRef>dsP1</bpmn:targetRef></bpmn:dataOutputAssociation><bpmn:dataOutputAssociation id="DOA_S10_dsB1"><bpmn:targetRef>dsB1</bpmn:targetRef></bpmn:dataOutputAssociation></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="gB2" name="¿Motivo pendiente? («Otro» sin detalle)" />
    <bpmn:serviceTask id="S15" name="Marcar la parada con motivo pendiente (aparece «Completar motivo»)" />
    <bpmn:intermediateThrowEvent id="S11" name="Alerta de detención en tiempo real"><bpmn:messageEventDefinition id="MED_S11" /></bpmn:intermediateThrowEvent>
    <bpmn:endEvent id="eB2" name="Detención registrada" />
    <bpmn:startEvent id="sC" name="Intervención terminada"><bpmn:messageEventDefinition id="MED_sC" /></bpmn:startEvent>
    <bpmn:serviceTask id="S12" name="Registrar INTERVENIR: estado LISTA y evento en la bitácora"><bpmn:dataOutputAssociation id="DOA_S12_dsP1"><bpmn:targetRef>dsP1</bpmn:targetRef></bpmn:dataOutputAssociation><bpmn:dataOutputAssociation id="DOA_S12_dsB1"><bpmn:targetRef>dsB1</bpmn:targetRef></bpmn:dataOutputAssociation></bpmn:serviceTask>
    <bpmn:endEvent id="eC" name="Intervención registrada" />
    <bpmn:startEvent id="sD" name="Reanudación solicitada"><bpmn:messageEventDefinition id="MED_sD" /></bpmn:startEvent>
    <bpmn:serviceTask id="S13" name="Reanudar: cerrar la parada, calcular su duración y volver a EN_PRODUCCION; evento REANUDAR"><bpmn:dataOutputAssociation id="DOA_S13_dsP1"><bpmn:targetRef>dsP1</bpmn:targetRef></bpmn:dataOutputAssociation><bpmn:dataOutputAssociation id="DOA_S13_dsB1"><bpmn:targetRef>dsB1</bpmn:targetRef></bpmn:dataOutputAssociation></bpmn:serviceTask>
    <bpmn:intermediateThrowEvent id="S14" name="Alerta de reanudación en tiempo real"><bpmn:messageEventDefinition id="MED_S14" /></bpmn:intermediateThrowEvent>
    <bpmn:endEvent id="eD" name="Línea reanudada" />
    <bpmn:startEvent id="sI" name="Motivo escrito por el usuario"><bpmn:messageEventDefinition id="MED_sI" /></bpmn:startEvent>
    <bpmn:serviceTask id="S16" name="Guardar el detalle del motivo y crear el evento COMPLETAR_MOTIVO (una transacción)"><bpmn:dataOutputAssociation id="DOA_S16_dsP2"><bpmn:targetRef>dsP2</bpmn:targetRef></bpmn:dataOutputAssociation><bpmn:dataOutputAssociation id="DOA_S16_dsB2"><bpmn:targetRef>dsB2</bpmn:targetRef></bpmn:dataOutputAssociation></bpmn:serviceTask>
    <bpmn:endEvent id="eI" name="Motivo completado" />
    <bpmn:startEvent id="sE" name="Cada 20 s y al cambiar la programación"><bpmn:timerEventDefinition id="TED_sE"><bpmn:timeCycle xsi:type="bpmn:tFormalExpression">R/PT20S</bpmn:timeCycle></bpmn:timerEventDefinition></bpmn:startEvent>
    <bpmn:serviceTask id="SE1" name="Calcular los avisos de parada abierta"><bpmn:dataInputAssociation id="DIA_SE1_dsP2"><bpmn:sourceRef>dsP2</bpmn:sourceRef></bpmn:dataInputAssociation><bpmn:dataInputAssociation id="DIA_SE1_dsA"><bpmn:sourceRef>dsA</bpmn:sourceRef></bpmn:dataInputAssociation></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="gE" name="¿Parada abierta más de N min? (pausa: más que su estándar)" />
    <bpmn:intermediateThrowEvent id="SE2" name="Aviso rojo: parada abierta"><bpmn:messageEventDefinition id="MED_SE2" /></bpmn:intermediateThrowEvent>
    <bpmn:endEvent id="eE" name="Aviso publicado" />
    <bpmn:endEvent id="eE2" name="Sin aviso" />
    <bpmn:startEvent id="sG" name="Consulta de la bitácora"><bpmn:messageEventDefinition id="MED_sG" /></bpmn:startEvent>
    <bpmn:serviceTask id="SG1" name="Consultar los eventos del rango (≤ 31 días, ≤ 2000) y armar la vista por parada"><bpmn:dataInputAssociation id="DIA_SG1_dsB2"><bpmn:sourceRef>dsB2</bpmn:sourceRef></bpmn:dataInputAssociation></bpmn:serviceTask>
    <bpmn:endEvent id="eG" name="Bitácora mostrada (solo lectura)" />
    <bpmn:startEvent id="sH" name="Motivo escrito desde la bitácora"><bpmn:messageEventDefinition id="MED_sH" /></bpmn:startEvent>
    <bpmn:serviceTask id="SH1" name="Crear el evento COMPLETAR_MOTIVO (la bitácora no se edita)"><bpmn:dataOutputAssociation id="DOA_SH1_dsB2"><bpmn:targetRef>dsB2</bpmn:targetRef></bpmn:dataOutputAssociation></bpmn:serviceTask>
    <bpmn:endEvent id="eH" name="Motivo registrado" />
    <bpmn:startEvent id="sJ" name="Cierre de turno solicitado"><bpmn:messageEventDefinition id="MED_sJ" /></bpmn:startEvent>
    <bpmn:serviceTask id="SJ1" name="Buscar las paradas con motivo pendiente del turno"><bpmn:dataInputAssociation id="DIA_SJ1_dsB2"><bpmn:sourceRef>dsB2</bpmn:sourceRef></bpmn:dataInputAssociation></bpmn:serviceTask>
    <bpmn:intermediateThrowEvent id="SJ2" name="Aviso: paradas con motivo pendiente (no bloquea el cierre)"><bpmn:messageEventDefinition id="MED_SJ2" /></bpmn:intermediateThrowEvent>
    <bpmn:endEvent id="eJ" name="Aviso mostrado" />
    <bpmn:dataStoreReference id="dsW" name="sync/workers" dataStoreRef="DS_workers" />
